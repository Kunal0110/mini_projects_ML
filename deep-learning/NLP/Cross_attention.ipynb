    {
      "cell_type": "code",
      "source": [
        "def get_token_indices(prompt: str, target_word: str, tokenizer):\n",
        "    \"\"\"\n",
        "    Returns token indices whose decoded string overlaps target_word.\n",
        "    (Tokenization can split words, so we match loosely.)\n",
        "    \"\"\"\n",
        "    tokens = tokenizer(prompt, return_tensors=\"pt\")\n",
        "    input_ids = tokens.input_ids[0].tolist()\n",
        "    decoded = [tokenizer.decode([tid]).strip() for tid in input_ids]\n",
        "\n",
        "    target = target_word.lower()\n",
        "    idxs = []\n",
        "    for i, piece in enumerate(decoded):\n",
        "        if piece and (piece.lower() in target or target in piece.lower()):\n",
        "            idxs.append(i)\n",
        "    return idxs, decoded\n",
        "\n",
        "def aggregate_word_attention(attn_store: dict, token_indices: list, image_size=(512, 512)):\n",
        "    \"\"\"\n",
        "    Aggregates stored cross-attn maps across layers/steps/heads into a single heatmap\n",
        "    for given token indices, handling multi-resolution attention (e.g., 64x64, 32x32).\n",
        "    \"\"\"\n",
        "    maps = []\n",
        "\n",
        "    for _layer_name, attn_list in attn_store.items():\n",
        "        for attn_probs in attn_list:\n",
        "            # attn_probs: (batch*heads, hw, text_tokens)\n",
        "            bh, hw, tt = attn_probs.shape\n",
        "\n",
        "            if len(token_indices) == 0:\n",
        "                continue\n",
        "\n",
        "            # average heads (assumes batch=1; still fine for your current setup)\n",
        "            attn_mean = attn_probs.mean(dim=0)  # (hw, tt)\n",
        "\n",
        "            token_attn = attn_mean[:, token_indices].mean(dim=1)  # (hw,)\n",
        "\n",
        "            side = int(hw ** 0.5)\n",
        "            if side * side != hw:\n",
        "                # if non-square (rare here), skip to avoid bad reshape\n",
        "                continue\n",
        "\n",
        "            token_attn_2d = token_attn.view(side, side)  # (side, side)\n",
        "            maps.append(token_attn_2d)\n",
        "\n",
        "    if not maps:\n",
        "        return None\n",
        "\n",
        "    # Resize all maps to a common grid (use the largest side present)\n",
        "    target_side = max(m.shape[0] for m in maps)\n",
        "\n",
        "    resized = []\n",
        "    for m in maps:\n",
        "        m4 = m.unsqueeze(0).unsqueeze(0)  # (1,1,h,w)\n",
        "        m4 = F.interpolate(m4, size=(target_side, target_side), mode=\"bilinear\", align_corners=False)\n",
        "        resized.append(m4.squeeze(0).squeeze(0))\n",
        "\n",
        "    heat = torch.stack(resized, dim=0).mean(dim=0)\n",
        "\n",
        "    # Normalize\n",
        "    heat = heat - heat.min()\n",
        "    heat = heat / (heat.max() + 1e-8)\n",
        "\n",
        "    # Upscale to image size\n",
        "    heat = heat.unsqueeze(0).unsqueeze(0)\n",
        "    heat = F.interpolate(heat, size=image_size, mode=\"bilinear\", align_corners=False)\n",
        "\n",
        "    return heat.squeeze().cpu().numpy()\n"
      ],
