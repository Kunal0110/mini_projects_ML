        "prompt = \"a photo of a red vintage car parked in front of a snowy mountain at sunset\"\n",
        "words_to_probe = [\"car\", \"mountain\", \"sunset\", \"red\"]\n",
        "\n",
        "# Clear store for a clean run\n",
        "attn_store.clear()\n",
        "\n",
        "generator = torch.Generator(device=device).manual_seed(7)\n",
        "\n",
        "out = pipe(\n",
        "    prompt=prompt,\n",
        "    num_inference_steps=25,\n",
        "    guidance_scale=7.5,  # CFG strength\n",
        "    generator=generator,\n",
        ")\n",
        "\n",
        "img: Image.Image = out.images[0]\n",
        "img.show()\n",
        "\n",
        "# Plot attention heatmaps per word\n",
        "fig, axes = plt.subplots(1, len(words_to_probe), figsize=(4 * len(words_to_probe), 4))\n",
        "if len(words_to_probe) == 1:\n",
        "    axes = [axes]\n",
        "\n",
        "for ax, w in zip(axes, words_to_probe):\n",
        "    idxs, decoded = get_token_indices(prompt, w, pipe.tokenizer)\n",
        "    heat = aggregate_word_attention(attn_store, idxs, image_size=img.size)\n",
        "\n",
        "    ax.set_title(f\"Attention: {w}\\n(token idxs: {idxs})\")\n",
        "    ax.axis(\"off\")\n",
        "    ax.imshow(img)\n",
        "    if heat is not None:\n",
        "        ax.imshow(heat, alpha=0.45)  # overlay heatmap\n",
        "    else:\n",
        "        ax.text(0.5, 0.5, \"No attn found\", ha=\"center\", va=\"center\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Optional: print tokenization to understand splits\n",
        "idxs_all, decoded_all = get_token_indices(prompt, \"\", pipe.tokenizer)\n",
        "print(list(enumerate(decoded_all)))"
